{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "!/Books/**/*.*",
          "!*.pmtiles",
          "!/map"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)",
          "!/Books/**/*.*",
          "!*.pmtiles",
          "!/map"
        ]
      }
    },
    {
      "name": "map-assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/map/**/*.(pbf|json|png|geojson)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "qs",
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "5s",
        "maxAge": "14d",
        "refreshAhead": "1d",
        "maxSize": 100
      },
      "urls": [
        "/module/qs/farmers",
        "/module/qs/drugs"
      ]
    },
    {
      "name": "ldapquery",
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "5s",
        "maxAge": "14d",
        "refreshAhead": "1d",
        "maxSize": 100
      },
      "urls": [
        "/module/ldapquery/users"
      ]
    },
    {
      "name": "meta",
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "5s",
        "maxAge": "14d",
        "refreshAhead": "1d",
        "maxSize": 100
      },
      "urls": [
        "/module/meta/meta"
      ]
    },
    {
      "name": "news",
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "5s",
        "maxAge": "14d",
        "refreshAhead": "1d",
        "maxSize": 100
      },
      "urls": [
        "/module/news/news"
      ]
    },
    {
      "name": "travelexpenses",
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "5s",
        "maxAge": "14d",
        "refreshAhead": "1d",
        "maxSize": 100
      },
      "urls": [
        "/module/travel-expenses/travelmeta"
      ]
    }
  ]
}